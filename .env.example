# Variable names only; never commit values. Copy to .env (gitignored) for local dev.
# Local Supabase values come from `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only (route handlers listed in docs/05-PAYMENTS.md)
SUPABASE_DB_URL=
RESEND_API_KEY=
SHIPPO_API_KEY=                     # per-tenant in Vault in prod; env only for local dev
STRIPE_SECRET_KEY=                  # billing (tenant subscriptions)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local demo owner for `pnpm db:demo-owner` (local Supabase only)
KOVARIO_DEMO_EMAIL=
KOVARIO_DEMO_PASSWORD=
