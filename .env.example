# Variable names only; never commit values. Copy to .env (gitignored) for local dev.
# Local Supabase values come from `supabase status` after `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=          # server-only (route handlers listed in docs/05-PAYMENTS.md, docs/07 §4)
SUPABASE_DB_URL=
RESEND_API_KEY=
SHIPPO_API_KEY=                     # per-tenant in Vault (`shippo_api_key:<org id>`) in prod; env only for local dev
SHIPPO_WEBHOOK_TOKEN=               # platform secret; each org's webhook token = HMAC(this, org id), shown in Admin → Sites — never hand this value out
STRIPE_SECRET_KEY=                  # billing (tenant subscriptions): Edge Function secret for billing-checkout/-portal
STRIPE_WEBHOOK_SECRET=              # Edge Function secret for billing-webhook (`supabase secrets set`)
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Local demo owner for `pnpm db:demo-owner` (local Supabase only)
FILLETRY_DEMO_EMAIL=
FILLETRY_DEMO_PASSWORD=

# Deploys (docs/11-DEPLOY.md). GitHub Actions secrets, not local .env values:
# repository secrets for staging, `production` environment secrets for prod.
SUPABASE_ACCESS_TOKEN=              # Supabase personal access token (prod env overrides it)
SUPABASE_STAGING_PROJECT_REF=
SUPABASE_STAGING_DB_PASSWORD=
SUPABASE_PROD_PROJECT_REF=
SUPABASE_PROD_DB_PASSWORD=
# GitHub Actions variables (not secret): STAGING_SITE_URL, STAGING_REDIRECT_URLS, PROD_REDIRECT_URLS,
# SUPABASE_STAGING_POOLER_HOST, SUPABASE_PROD_POOLER_HOST

# Preview demo org on staging, `pnpm db:preview-demo` (run by a human, never in CI);
# also needs SUPABASE_STAGING_PROJECT_REF (the script refuses any other host)
STAGING_SUPABASE_URL=
STAGING_SUPABASE_SERVICE_ROLE_KEY=
FILLETRY_PREVIEW_DEMO_EMAIL=
FILLETRY_PREVIEW_DEMO_PASSWORD=
