{
  "name": "print-agent",
  "version": "0.0.0",
  "private": true,
  "description": "Plant-LAN service: printers (ZPL over TCP 9100) and scale.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "build": "bun build ./src/main.ts --compile --outfile dist/filletry-print-agent",
    "start": "bun run src/main.ts"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "bun": "1.3.1",
    "typescript": "5.9.3",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.118.0",
    "db": "workspace:*",
    "labels": "workspace:*",
    "zod": "4.6.7"
  }
}
