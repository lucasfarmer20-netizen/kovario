{
  "defaultBranch": "main",
  "sessionPrefix": "kv",
  "symlinks": [".env"],
  "postCreate": ["pwsh -NoProfile -File scripts/ao-post-create.ps1"],
  "agentConfig": { "permissions": "bypass-permissions" },
  "worker": { "agent": "claude-code", "agentConfig": { "model": "claude-opus-5-5", "permissions": "bypass-permissions" } },
  "orchestrator": { "agent": "claude-code", "agentConfig": { "model": "claude-opus-5-5" } },
  "agentRulesFile": ".agent-rules.md",
  "reviewers": [{ "harness": "claude-code" }],
  "autoReview": true,
  "workersRequestReview": true
}
