{
  "defaultBranch": "main",
  "sessionPrefix": "kv",
  "symlinks": [
    ".env"
  ],
  "postCreate": [
    "pwsh -NoProfile -File scripts/ao-post-create.ps1"
  ],
  "agentConfig": {},
  "worker": {
    "agent": "claude-code",
    "agentConfig": {
      "effort": "high",
      "permissions": "bypass-permissions"
    }
  },
  "orchestrator": {
    "agent": "claude-code",
    "agentConfig": {
      "model": "claude-opus-5-5",
      "effort": "high",
      "permissions": "bypass-permissions"
    }
  },
  "agentRulesFile": ".agent-rules.md",
  "reviewers": [
    {
      "harness": "codex"
    }
  ],
  "autoReview": true,
  "workersRequestReview": true
}
